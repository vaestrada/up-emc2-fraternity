# Form delivery (contact + pledge forms).
# Until both RESEND_API_KEY and CONTACT_TO_EMAIL are set (locally and in Vercel →
# Project Settings → Environment Variables), submissions validate but are not
# emailed, and the UI tells the sender to also reach out on Facebook.

# API key from https://resend.com (free tier is plenty)
RESEND_API_KEY=

# Where submissions land, e.g. the Alumni Association inbox
CONTACT_TO_EMAIL=

# Optional. Defaults to Resend's onboarding sender; set after verifying a domain
# in Resend, e.g. "EMC² Fraternity <noreply@emc2fraternity.org>"
CONTACT_FROM_EMAIL=
