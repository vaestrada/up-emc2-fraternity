# Form delivery (contact + pledge forms).
# Until both RESEND_API_KEY and CONTACT_TO_EMAIL are set (locally and in Vercel →
# Project Settings → Environment Variables), submissions validate but are not
# emailed, and the UI tells the sender to also reach out on Facebook.

# API key from https://resend.com (free tier is plenty)
RESEND_API_KEY=

# Where submissions land, e.g. the Alumni Association inbox
CONTACT_TO_EMAIL=

# Optional. Defaults to Resend's onboarding sender; set after verifying a domain
# in Resend, e.g. "EMC² Fraternity <noreply@emc2fraternity.org>"
CONTACT_FROM_EMAIL=

# Admin moderation panel (/admin). Set a strong shared password here and in
# Vercel to unlock the review queue; leave empty to keep /admin disabled.
ADMIN_PASSWORD=

# Absolute base URL for canonical links, the sitemap, and Open Graph cards.
# Defaults to the vercel.app host; set this when the real domain goes live.
NEXT_PUBLIC_SITE_URL=

# Synthetic walkthrough content — the four AI-generated "prominent brods", the
# two demo donor quotes, the demo gallery on /history, and the demo register
# video on /brods. Shown by default so the board walkthrough has something to
# look at. Set to "off" for the public launch: every synthetic item disappears
# and the pages fall back to their honest "entry pending" states.
NEXT_PUBLIC_DEMO_CONTENT=

# Supabase — provided by the Vercel integration (store prefix "emc2fraternity").
# Do NOT commit real values; keep them in .env.local / Vercel only.
# NEXT_PUBLIC_emc2fraternity_SUPABASE_URL=
# emc2fraternity_SUPABASE_SERVICE_ROLE_KEY=
# emc2fraternity_POSTGRES_URL_NON_POOLING=

# The Member Portal (/portal) needs the anon key as NEXT_PUBLIC — it's safe
# to expose (unlike the service-role key above): access to real rows is
# enforced by the members table's Row Level Security policies, not by
# keeping this key secret. (Corrected from the previous non-public
# "emc2fraternity_SUPABASE_ANON_KEY" name, which the browser client could
# never actually have read.) Also add "<your domain>/auth/callback" to
# Supabase Dashboard → Authentication → URL Configuration → Redirect URLs.
# NEXT_PUBLIC_emc2fraternity_SUPABASE_ANON_KEY=
